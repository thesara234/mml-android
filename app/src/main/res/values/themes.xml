<resources>
    <style name="Theme.Mml" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Mml.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/moana_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mml</item>
    </style>
</resources>
